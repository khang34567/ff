<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121826"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REMOTE TOUCH &amp; SCREEN STREAM"
            android:textColor="#38BDF8"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Samsung Galaxy A02s <-> Windows PC (TCP Port 8888)"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <!-- Bước 1: Cấp quyền Accessibility -->
        <TextView
            android:id="@+id/tvAccessStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trạng thái Trợ năng: Chưa bật"
            android:textColor="#F87171"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="1. Cấp quyền Trợ năng (Accessibility)"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:layout_marginBottom="18dp" />

        <!-- Bước 2: Cấp quyền Chụp màn hình -->
        <TextView
            android:id="@+id/tvProjectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trạng thái Chụp màn hình: Chưa cấp quyền"
            android:textColor="#FBBF24"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/btnScreenCapture"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="2. Cấp quyền Chụp màn hình"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:layout_marginBottom="18dp" />

        <!-- Bước 3: Nhập IP PC và Kết nối -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Địa chỉ IP LAN của Máy tính (PC):"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/etPcIp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ví dụ: 192.168.1.10"
            android:text="192.168.1."
            android:inputType="textUri"
            android:background="#1E293B"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="3. Kết nối tới PC (Port 8888)"
            android:backgroundTint="#E11D48"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0F172A"
            android:padding="14dp"
            android:text="Nhật ký: Sẵn sàng. Hãy hoàn thành bước 1 và 2 trước khi bấm Kết nối."
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
